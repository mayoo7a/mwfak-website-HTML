<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MarahTouqan.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- the images, videos and CV are shared with the current static site, so the repo keeps only one copy (the assets folder at the repo root) -->
    <None Include="..\..\assets\**" Link="wwwroot\assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <!-- the editable content file is copied next to the app when it is published -->
    <Content Remove="Data\admin.json;Data\backups\**" />
    <Content Update="Data\content.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
