@page "/"
@model MarahTouqan.Web.Pages.IndexModel
@inject MarahTouqan.Web.Services.ContentService Content
@using System.Text.Json
@{
    var H = Content.Current.Home;
    ViewData["Slug"] = "home";
    ViewData["Scripts"] = new[] { "home-footer-year.js", "home.js", "home-hero-reel.js", "home-email-card.js" };
}
<!-- Custom pixel cursor - uses the uploaded cursor.svg file -->
<div class="pixel-cursor" id="pixelCursor" aria-hidden="true">
  <img src="assets/cursor.svg" alt="" width="36" height="36" />
</div>

<!-- Cat photo that follows the cursor while hovering "cat cuddles" -->
<div class="cat-follower" id="catFollower" aria-hidden="true"></div>

<!-- Off-canvas menu -->
<nav class="menu-panel" id="menuPanel" aria-label="Main menu" aria-hidden="true" inert>
  <a href="my-work.html" data-hover>Work</a>
  <a href="services.html" data-hover>Services</a>
  <a href="#about" data-hover>About</a>
  <a href="#contact" data-hover>Contact</a>
</nav>

<!-- Hero -->
<section class="hero hero--reel">
  <!-- Header on top -->
  <header class="header">
    <a href="#" class="brand" data-hover aria-label="Marah Touqan home">
      <img src="assets/logo.png" alt="Marah Touqan logo" width="256" height="239" />
      <span class="brand-name">Marah Touqan</span>
    </a>

    <div class="header-actions">
      <nav class="header-nav" aria-label="Primary">
        <a href="my-work.html" data-hover>Work</a>
        <a href="services.html" data-hover>Services</a>
        <a href="#about" data-hover>About</a>
        <a href="#contact" data-hover>Contact</a>
      </nav>
      <a class="quote-btn" href="@Content.Site.WhatsAppUrl" target="_blank" rel="noopener" data-hover>Get a quote</a>
      <button class="burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menuPanel" data-hover>
        <span></span><span></span>
      </button>
    </div>
  </header>

  <!-- Hero showreel: full width, plays once when the site opens. Click the video to pause or play; a replay button appears at the end -->
  <div class="hero-reel-full" id="heroReelWrap">
    <i class="hero-reel-side hero-reel-side--l" aria-hidden="true"></i>
    <i class="hero-reel-side hero-reel-side--r" aria-hidden="true"></i>
    <video class="hero-reel-video" id="heroReel"
           data-src="@H.HeroVideo" data-src-small="@H.HeroVideoSmall"
           poster="@H.HeroPoster"
           autoplay muted playsinline preload="metadata"
           disablepictureinpicture disableremoteplayback
           tabindex="0" aria-label="@H.HeroAriaLabel"></video>
    <div class="hero-reel-ctl">
      <button class="hero-reel-btn" id="heroReelBtn" type="button" data-hover aria-label="Replay the showreel">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
        <span class="hero-reel-btn-label">Replay</span>
      </button>
    </div>
  </div>
  <h1 class="sr-only">@H.HeroTitle</h1>

</section>

<!-- ============================================================
     INTRO / ABOUT SECTION - centered manifesto with floating stickers
     (inspired by idyllic's "FOR THE TRAILBLAZERS" centered layout)
     ============================================================ -->
<section class="intro" id="about">

  <!-- DESIGN-themed floating stickers (positioned away from the text) -->

  <!-- Top-left: paint palette with color dots -->
  <div class="sticker palette-sticker" data-service="Brand Identity">
    <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <path d="M100 25 C 50 25, 18 65, 18 110 C 18 145, 48 168, 80 162 C 90 160, 92 152, 88 145 C 80 132, 92 116, 108 120 C 122 124, 130 134, 148 134 C 172 134, 184 115, 184 92 C 184 55, 148 25, 100 25 Z"
            fill="#F2EBE8" stroke="#0E1C41" stroke-width="6" stroke-linejoin="round"/>
      <circle cx="62" cy="82" r="11" fill="#FA5643" stroke="#0E1C41" stroke-width="3"/>
      <circle cx="98" cy="62" r="11" fill="#F9A323" stroke="#0E1C41" stroke-width="3"/>
      <circle cx="138" cy="78" r="11" fill="#D23697" stroke="#0E1C41" stroke-width="3"/>
      <circle cx="148" cy="108" r="11" fill="#1E7CDF" stroke="#0E1C41" stroke-width="3"/>
    </svg>
  </div>

  <!-- Top-right: pen tool / bezier curve with anchor points -->
  <div class="sticker pen-sticker" data-service="Logo Design">
    <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <path d="M25 160 C 65 50, 135 50, 175 160" fill="none" stroke="#0E1C41" stroke-width="6" stroke-linecap="round"/>
      <line x1="32" y1="155" x2="100" y2="58" stroke="#0E1C41" stroke-width="2" stroke-dasharray="5,5"/>
      <line x1="168" y1="155" x2="100" y2="58" stroke="#0E1C41" stroke-width="2" stroke-dasharray="5,5"/>
      <rect x="20" y="150" width="18" height="18" fill="#F9A323" stroke="#0E1C41" stroke-width="3"/>
      <rect x="91" y="50" width="18" height="18" fill="#D23697" stroke="#0E1C41" stroke-width="3"/>
      <rect x="162" y="150" width="18" height="18" fill="#1E7CDF" stroke="#0E1C41" stroke-width="3"/>
    </svg>
  </div>

  <!-- Stacked layers icon (Photoshop/Figma vibe) -->
  <div class="sticker layers-sticker" data-service="UI/UX Design">
    <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <rect x="20"  y="70" width="130" height="90" rx="6" fill="#1E7CDF" stroke="#0E1C41" stroke-width="5" stroke-linejoin="round"/>
      <rect x="40"  y="45" width="130" height="90" rx="6" fill="#F9A323" stroke="#0E1C41" stroke-width="5" stroke-linejoin="round"/>
      <rect x="60"  y="20" width="130" height="90" rx="6" fill="#FA5643" stroke="#0E1C41" stroke-width="5" stroke-linejoin="round"/>
    </svg>
  </div>

  <!-- Bottom-right: ruler with tick marks -->
  <div class="sticker ruler-sticker" data-service="Packaging & Print">
    <svg viewBox="0 0 220 90" xmlns="http://www.w3.org/2000/svg">
      <rect x="8" y="24" width="204" height="48" fill="#F9A323" stroke="#0E1C41" stroke-width="5" stroke-linejoin="round"/>
      <line x1="28"  y1="24" x2="28"  y2="50" stroke="#0E1C41" stroke-width="3"/>
      <line x1="48"  y1="24" x2="48"  y2="40" stroke="#0E1C41" stroke-width="3"/>
      <line x1="68"  y1="24" x2="68"  y2="40" stroke="#0E1C41" stroke-width="3"/>
      <line x1="88"  y1="24" x2="88"  y2="40" stroke="#0E1C41" stroke-width="3"/>
      <line x1="108" y1="24" x2="108" y2="50" stroke="#0E1C41" stroke-width="3"/>
      <line x1="128" y1="24" x2="128" y2="40" stroke="#0E1C41" stroke-width="3"/>
      <line x1="148" y1="24" x2="148" y2="40" stroke="#0E1C41" stroke-width="3"/>
      <line x1="168" y1="24" x2="168" y2="40" stroke="#0E1C41" stroke-width="3"/>
      <line x1="188" y1="24" x2="188" y2="50" stroke="#0E1C41" stroke-width="3"/>
    </svg>
  </div>

  <div class="intro-container">

    <h2 class="intro-headline">
      I'm <span class="name">@Content.Site.Name</span><br>
      @H.IntroLine2<br>
      <span class="pixel">@H.IntroPixel</span> &amp; <span class="underline">@H.IntroUnderline</span>
    </h2>

    <div class="intro-body">
      @foreach (var para in H.IntroParagraphs) {<p>@Html.Raw(para)</p>}
      <p class="intro-cv"><a href="@Content.Site.CvPath" target="_blank" rel="noopener">@H.CvLinkText <span aria-hidden="true">↗</span></a></p>
    </div>
    </div>

  </div>
</section>

<!-- ============================================================
     MAGNIFICENT SECTION - full-bleed numbered service list
     ============================================================ -->
<section class="magnificent" id="services">

  <div class="mag-header">

    <div class="mag-title-block">
      <div class="mag-word-wrap">
        <span class="mag-title-pre">@H.DragonPre</span>
        <h2 class="mag-word-anton">@H.DragonWord</h2>
      </div>
      <img src="assets/dragon.gif" alt="" class="mag-dragon-gif" aria-hidden="true" width="500" height="226" loading="lazy" decoding="async" />
      <div class="dragon-tooltip" aria-hidden="true">@Html.Raw(H.DragonTooltip)</div>
    </div>

  </div>

  <!-- Stacked, tilted service cards -->
  <div class="mag-cards">

    @for (var ci = 0; ci < H.Cards.Count; ci++) {
      var cd = H.Cards[ci];
      <a class="mag-card" data-card="@((ci+1).ToString("00"))" href="services.html#@cd.Service">
        <h3>@cd.Heading1<br> @cd.Heading2</h3>
        <p class="mag-card-desc">@cd.Text</p>
        <div class="mag-card-ribbon">@cd.Ribbon</div>
      </a>
    }

  </div>


</section>

<!-- ============================================================
     SELECTED WORK SECTION
     ============================================================ -->
<section class="work" id="work">

  <h2 class="work-title">
    <span class="work-title-main">@H.WorkTitle</span>
  </h2>

  <div class="work-hero">
    <div class="switch-frame">
      <img src="assets/work-frame.svg" alt="" class="work-hero-img" width="3054" height="718" />
      <a class="switch-screen" href="my-work.html" aria-label="See all my work">
        @for (var si = 0; si < H.Slides.Count; si++) {
          var sl = H.Slides[si]; var pr = Content.Current.Work.Find(sl.Project);
          <img src="assets/portfolio/@(sl.Project).webp" alt="@sl.Alt" data-name="@pr?.Name" data-type="@sl.Type" data-stem="@sl.Project" class="screen-slide@(si == 0 ? " is-active" : "")" width="1400" height="745" loading="@(si == 0 ? "eager" : "lazy")" @(si == 0 ? Html.Raw("fetchpriority=\"high\" ") : null)decoding="async" />
        }
      </a>
      <button type="button" class="joy-btn" data-joy="work" style="left:95.70%;top:25.13%" aria-label="Open this project (A)"></button>
      <button type="button" class="joy-btn" data-joy="prev" style="left:92.49%;top:32.23%" aria-label="Previous project (B)"></button>
      <button type="button" class="joy-btn" data-joy="pause" style="left:89.30%;top:25.13%" aria-label="Pause or resume slideshow (Y)"></button>
      <button type="button" class="joy-btn" data-joy="next" style="left:92.49%;top:18.02%" aria-label="Next project (X)"></button>
      <button type="button" class="joy-btn" data-joy="prev" style="left:4.06%;top:52.18%" aria-label="Previous project"></button>
      <button type="button" class="joy-btn" data-joy="next" style="left:10.47%;top:52.69%" aria-label="Next project"></button>
      <button type="button" class="joy-btn" data-joy="work" style="left:90.40%;top:71.27%" aria-label="See all my work"></button>
    </div>
  </div>

  <div class="work-caption" aria-live="polite">
    <div class="wc-text"><span class="wc-name" id="wcName">Brand and website</span><span class="wc-type" id="wcType">Battikhi Stays</span></div>
  </div>
  <div class="work-cta"><a class="panel-cta panel-cta--pink" href="my-work.html">@H.WorkCta</a></div>

</section>

<!-- ============================================================
     TESTIMONIALS SECTION
     ============================================================ -->
<section class="testimonials" id="testimonials">
  <canvas class="gx-canvas" id="gxCanvas" aria-hidden="true"></canvas>

  <div class="testimonials-inner">

    <h2 class="testimonials-title">
      <span class="testimonials-title-banner">
        @for (var zi = 0; zi < H.ReviewsTitle.Count; zi++) {<span class="zg zg-@(zi+1)">@H.ReviewsTitle[zi]</span>@Html.Raw("\n        ")}
      </span>
    </h2>

    <div class="cn" id="cn">
      <canvas class="cn-svg cn-gal" id="cnGal" role="img" aria-label="A spiral galaxy. The bright stars are client reviews; select one to read it."></canvas>
      <div class="cn-text" id="cnText" aria-live="polite">
        <div class="cn-card">
          <p class="cn-quote" id="cnQuote"></p>
          <p class="cn-name" id="cnName"></p>
          <p class="cn-role" id="cnRole"></p>
        </div>
        <div class="cn-dots" id="cnDots"></div>
      </div>
    </div>

  </div>

  </div>

</section>

<!-- ============================================================
     CONTACT SECTION
     ============================================================ -->
<partial name="_Contact" model="true" />

<!-- ============================================================
     FOOTER
     ============================================================ -->
<partial name="_Footer" model="true" />

@section Scripts {
<script>window.siteReviews = @Html.Raw(JsonSerializer.Serialize(H.Reviews.Select(r => new { name = r.Name, role = r.Role, review = r.Text }), new JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }).Replace("<", "\\u003c"));</script>
}
