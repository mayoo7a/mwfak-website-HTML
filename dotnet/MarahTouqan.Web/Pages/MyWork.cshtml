@page "/my-work.html"
@model MarahTouqan.Web.Pages.MyWorkModel
@inject MarahTouqan.Web.Services.ContentService Content
@{
    var work = Content.Current.Work;
    ViewData["Slug"] = "my-work";
    ViewData["Scripts"] = new[] { "my-work.js", "my-work-pixel-cursor.js", "my-work-email-card.js", "my-work-menu.js", "my-work-menu-top-links.js", "my-work-header-shrink.js" };
}
<div class="pixel-cursor" id="pixelCursor" aria-hidden="true">
  <img src="assets/cursor.svg" alt="" width="36" height="36" />
</div>

<partial name="_Header" />
<partial name="_MenuPanel" />
<div class="page-back"><a class="back-link" href="index.html"><span aria-hidden="true">←</span> Back home</a></div>

<section class="intro">
  <div class="intro-left">
    <h1><span>@work.Title1</span> <span>@work.Title2</span></h1>
  </div>
</section>

<section class="gallery">
@for (var i = 0; i < work.Groups.Count; i++)
{
    var group = work.Groups[i];
    if (group.PairWithNext && i + 1 < work.Groups.Count)
    {
  <div class="work-pair">
    <partial name="_WorkGroup" model="group" />
    <partial name="_WorkGroup" model="work.Groups[i + 1]" />
  </div>
        i++;
    }
    else
    {
    <partial name="_WorkGroup" model="group" />
    }
}

</section>

<partial name="_Contact" model="false" />

<partial name="_Footer" model="false" />

<!-- Lightbox for full-size project view -->
<div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Project">
  <button class="lightbox-close" aria-label="Close">×</button>
  <figure class="lb-fig">
    <div class="lb-progress" id="lb-progress" aria-hidden="true"></div>
    <div class="lb-stage">
      <button class="lb-arrow lb-prev" aria-label="Previous project"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button class="lb-arrow lb-next" aria-label="Next project"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
      <img alt="" id="lightbox-img" />
    </div>
    <figcaption class="lb-cap"><span class="lb-type" id="lb-type"></span><strong class="lb-name" id="lb-name"></strong><p class="lb-desc" id="lb-desc"></p></figcaption>
  </figure>
</div>
