@page "/services.html"
@model MarahTouqan.Web.Pages.ServicesModel
@inject MarahTouqan.Web.Services.ContentService Content
@{
    var services = Content.Current.Services;
    ViewData["Slug"] = "services";
    ViewData["Scripts"] = new[] { "services-tabs.js", "services-pixel-cursor.js", "services-email-card.js", "services-menu.js", "services-header-top.js", "services-menu-top-links.js", "services-project-center.js" };
}
<div class="pixel-cursor" id="pixelCursor" aria-hidden="true">
  <img src="assets/cursor.svg" alt="" width="36" height="36" />
</div>

<partial name="_Header" model="false" />
<partial name="_MenuPanel" model="false" />
<div class="page-back"><a class="back-link" href="index.html"><span aria-hidden="true">←</span> @Content.Current.Ui.BackHomeText</a></div>

<section class="stage">
  <div class="stage-inner">
    <h1 class="stage-title">@Content.Current.ServicesPage.Title</h1>
    <div class="menu-layout">
      <nav class="menu" aria-label="Services">
@foreach (var svc in services)
{
<a class="menu-item" href="#@svc.Slug" data-slug="@svc.Slug" aria-current="false" style="--box:url(/assets/@svc.BoxImage);--txt:#F7F7F7"><span class="menu-label">@svc.MenuLabel</span></a>
}
      </nav>
      <div class="svc-list-wrap">
@foreach (var svc in services)
{
<article class="svc" id="@svc.Slug" style="--box:url(/assets/@svc.BoxImage);--txt:#F7F7F7;--c:@svc.Color">
  <div class="svc-top">
  <header class="svc-head">
    <h2>@svc.Heading1<br> @svc.Heading2</h2>
    <p class="svc-tag">@svc.Tagline</p>
  </header>
  <div class="svc-body">
    <p class="svc-desc">@svc.Description</p>
  </div>
  <figure class="svc-proj"><img src="@svc.ProjectImage" alt="@svc.ProjectName project board" width="1400" height="745" loading="lazy" decoding="async"><figcaption>@Content.Current.Ui.SelectedProjectLabel <strong>@svc.ProjectName</strong>, @svc.ProjectType</figcaption><div class="svc-pricebox"><div class="svc-pricerow"><p class="svc-price"><span>@svc.PriceLabel</span><strong>@svc.Price</strong></p></div></div><div class="svc-cta svc-cta--proj"><a class="panel-cta" href="@Content.Site.WhatsAppUrl" target="_blank" rel="noopener">@svc.CtaText</a></div></figure>
  </div>
    <div class="svc-scopebox">
      <h3 class="svc-sub">@svc.ScopeTitle</h3>
      <ul class="svc-scope2">
@foreach (var item in svc.Scope)
{
<li><partial name="_ScopeIcon" model="item.Icon" /><div><span class="n">@item.Before<em>@item.Highlight</em>@item.After</span><span class="d">@item.Text</span></div></li>
}
      </ul>
  </div>
  <div class="svc-how">
    <h3 class="svc-sub">@svc.StepsTitle</h3>
    <ol class="svc-timeline">
@{ var n = 0; }
@foreach (var step in svc.Steps)
{
n++;
<li><span class="svc-num">@n</span><div class="svc-tltext"><strong>@step.Title</strong><span class="svc-steptext">@step.Text</span></div></li>
}
    </ol>
  </div>
  <div class="svc-fade"><div class="svc-fade-body">
  <div class="svc-end">
    <div class="svc-files">
      <h3 class="svc-sub">@svc.ReceiveTitle</h3>
@foreach (var group in svc.Receive)
{
@if (!string.IsNullOrWhiteSpace(group.Heading))
{
      <h4 class="svc-minor">@group.Heading</h4>
}
      <ul class="svc-check">@foreach (var line in group.Items){<li>@line</li>}</ul>
}
    </div>
    <div class="svc-pair">
      <div class="svc-filesbox">
      <h3 class="svc-sub">@svc.FilesTitle</h3>
      <ul class="svc-fmts">@foreach (var f in svc.Formats){<li>@f</li>}</ul>
      <p class="svc-filetext">@svc.FilesNote</p>
      </div>
    <div class="svc-tools">
      <h3 class="svc-sub">@svc.ToolsTitle</h3>
      <ul class="svc-toolrow">@foreach (var t in svc.Tools){<li><img src="assets/tools/@t.Icon" alt="@t.Name" width="30" height="30" loading="lazy" decoding="async"><span>@t.Name</span></li>}</ul>
    </div>
    </div>
  </div>
  </div><button type="button" class="svc-fade-btn" aria-expanded="false"><span class="more">@svc.MoreText</span><span class="less">@svc.LessText</span></button></div>
</article>
}
</div>
      </div>
    <p class="stage-hint">@Content.Current.ServicesPage.Hint</p>
  </div>
</section>

<partial name="_Contact" model="false" />

<partial name="_Footer" model="false" />
