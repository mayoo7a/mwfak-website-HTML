@using MarahTouqan.Web.Services
@inject ContentService Content
@model bool
@{ var Site = Content.Site; }
<section class="contact" id="contact">
  <div class="contact-inner">
    <div class="contact-layout">

      <div class="contact-header">
        <h2 class="contact-title">
          <span class="contact-title-banner">@Site.ContactTitle</span>
        </h2>
      </div>

      <div class="contact-grid">

        <a class="contact-card" href="mailto:@Site.Email" data-card="email">
          <span class="contact-card-text">
            <span class="contact-card-label">Email</span>
            <span class="contact-card-value">@Site.EmailCardText</span>
          </span>
        </a>

        <a class="contact-card" href="@Site.Behance" target="_blank" rel="noopener" data-card="behance">
          <span class="contact-card-text">
            <span class="contact-card-label">Behance</span>
            <span class="contact-card-value">@Site.BehanceHandle</span>
          </span>
        </a>

        <a class="contact-card" href="@Site.LinkedIn" target="_blank" rel="noopener" data-card="linkedin">
          <span class="contact-card-text">
            <span class="contact-card-label">LinkedIn</span>
            <span class="contact-card-value">@Site.LinkedInName</span>
          </span>
        </a>

        <a class="contact-card" href="@Site.WhatsAppUrl" target="_blank" rel="noopener" data-card="phone" aria-label="Message Marah on WhatsApp, @Site.PhoneDisplay">
          <span class="contact-card-text">
            <span class="contact-card-label">WhatsApp</span>
            <span class="contact-card-value">@Site.PhoneDisplay</span>
          </span>
        </a>

      </div>

    </div>
@if (Model)
{
    <div class="contact-footer">
      <p class="contact-signoff">
        <span class="ps-line"><em>P.S. </em>@Site.PostScript1</span> <span class="ps-line">@Site.PostScript2</span>
      </p>
    </div>
}
  </div>
</section>
