@using System.Text.Encodings.Web
@using System.Text.Json
@using MarahTouqan.Web.Services
@inject ContentService Content
@{
    var slug = (string)ViewData["Slug"]!;
    var site = Content.Site;
    var meta = Content.Page(slug);
    var isHome = slug == "home";
    var pageUrl = site.BaseUrl.TrimEnd('/') + meta.Path;
    var ogImage = site.BaseUrl.TrimEnd('/') + "/" + site.OgImage.TrimStart('/');
    var scripts = (string[])ViewData["Scripts"]!;
}
<!DOCTYPE html>
<html lang="en">
<head>
<script>/* a refresh always starts from the top of the same page */try{var __n=performance.getEntriesByType('navigation')[0];if(__n&&__n.type==='reload'){if('scrollRestoration' in history)history.scrollRestoration='manual';if(location.hash)history.replaceState(null,'',location.pathname+location.search);}}catch(e){}</script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@meta.Title</title>
<meta name="description" content="@meta.Description" />
<link rel="canonical" href="@pageUrl" />
<meta property="og:url" content="@pageUrl" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="@site.Name" />
<meta property="og:title" content="@meta.Title" />
<meta property="og:description" content="@meta.Description" />
<meta property="og:image" content="@ogImage" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="@site.OgImageAlt" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="@ogImage" />
@if (isHome)
{
<script>/* open at the top: stop the browser restoring an old scroll position before the first paint */
try { if ('scrollRestoration' in history && !location.hash) history.scrollRestoration = 'manual'; } catch (e) {}
</script>
<partial name="_StructuredData" />
}
<link rel="icon" type="image/png" href="~/assets/favicon.png" />
@if (isHome)
{
<meta name="theme-color" content="#F2EBE8" />
<link rel="preload" as="image" href="~/assets/hero-poster.webp" />
}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Serif+Display&family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">
<link rel="stylesheet" href="~/css/@(slug).css" asp-append-version="true" />
</head>
<body>
@RenderBody()
@foreach (var script in scripts)
{
<script src="~/js/@script" asp-append-version="true"></script>
}
</body>
</html>
